# ============================================================
# Temporal Scene Boundary Detection — .gitignore
# ============================================================

# ── macOS system files ───────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Python artefacts ─────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ── Raw video files (all formats) ────────────────────────────
# Keep local for processing; never push to GitHub
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.flv
*.wmv
*.m4v
*.ts

# ── Downloaded input videos directory ────────────────────────
input_videos/

# ── Generated audit / overlay video output ───────────────────
output/

# ── Generated shot-thumbnail images in ground_truth ─────────
# These are auto-generated by annotate_ground_truth.py and are
# very numerous (2700+ JPEGs, ~134 MB for online_video alone).
# The JSON annotation files in the same directories are KEPT.
ground_truth/online_video/*.jpg
ground_truth/online_video/*.jpeg
ground_truth/online_video/*.png
ground_truth/rel_news/*.jpg
ground_truth/rel_news/*.jpeg
ground_truth/rel_news/*.png

# Catch any future shot-thumbnail directories (shot_XXXX.jpg pattern)
ground_truth/**/shot_*.jpg
ground_truth/**/shot_*.jpeg
ground_truth/**/shot_*.png

# ── Jupyter / IDE artefacts ──────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── yt-dlp / download temp files ─────────────────────────────
*.part
*.ytdl
*.temp

# ── OS / editor artefacts ────────────────────────────────────
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── NOTE: results/ JSON and CSV are intentionally NOT ignored ─
# They are lightweight evaluation evidence for the internship
# project. The largest file is ~3 MB, well within GitHub limits.
